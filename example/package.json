{
  "name": "react-native-sync-tasks-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme SyncTasksExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\"",
    "harness:ios": "react-native-harness --config jest.harness.config.mjs --harnessRunner ios",
    "harness:android": "react-native-harness --config jest.harness.config.mjs --harnessRunner android"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-sync-tasks": "link:../"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-harness/platform-android": "1.5.0",
    "@react-native-harness/platform-apple": "1.5.0",
    "@react-native-harness/plugins": "1.5.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.40.6",
    "react-native-harness": "1.5.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
